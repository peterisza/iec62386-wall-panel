	(gr_text "230Vac mains voltage can accidentally be connected to the bus, so\nI kept 2.5mm clearance around all the pads that come between the\nconnector and the protection diodes.\n\nI was told by ChatGPT that this is the absolute minimum for 230Vac,\nbut I decided to go with it still because 230V is not normal operation,\nand the 3.81mm pitch connector (which is the de facto industry\nstandard for IEC 62386 devices) doesn't have more space between\nthe metal parts either."
		(at 68.35 55.6 0)
		(layer "Cmts.User")
		(uuid "561dafe6-f9fd-4777-97e0-a22e9c83058b")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
