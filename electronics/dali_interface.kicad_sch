			)
			(justify left top)
		)
		(uuid "1ab1d625-9725-4111-ab16-f9a65a7e1cd2")
	)
	(text_box "C6 is for EMI reduction"
		(exclude_from_sim no)
		(at 146.05 134.62 0)
		(size 16.51 6.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
